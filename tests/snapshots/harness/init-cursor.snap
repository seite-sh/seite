      "Write(templates/**)",
      "Write(static/**)",
      "Write(data/**)",
      "Write(seite.toml)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}

==> .cursor/hooks.json <==
{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "command -v seite >/dev/null 2>&1 && seite check --hook cursor || true",
        "timeout": 120
      }
    ],
    "postToolUse": [
      {
        "command": "command -v seite >/dev/null 2>&1 && seite check --hook cursor --post-edit || true",
        "timeout": 30,
        "matcher": "Write"
      }
    ]
  }
}

