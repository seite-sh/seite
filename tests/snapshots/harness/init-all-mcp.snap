==> .claude/settings.json <==
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write(content/**)",
      "Write(templates/**)",
      "Write(static/**)",
      "Write(data/**)",
      "Edit(content/**)",
      "Edit(templates/**)",
      "Edit(static/**)",
      "Edit(data/**)",
      "Edit(seite.toml)",
      "Bash(seite build:*)",
      "Bash(seite build)",
      "Bash(seite check:*)",
      "Bash(seite check)",
      "Bash(seite new:*)",
      "Bash(seite serve:*)",
      "Bash(seite theme apply:*)",
      "Bash(seite theme list:*)",
      "Bash(seite theme list)",
      "Bash(seite context:*)",
      "Bash(seite context)",
      "Bash(seite docs:*)",
      "Bash(seite docs)",
      "Bash(seite page:*)",
      "Bash(seite search:*)",
      "Bash(seite stats:*)",
      "Bash(seite stats)",
      "Bash(seite templates:*)",
      "Bash(seite templates)",
      "Bash(seite frontmatter:*)",
      "Bash(seite explain:*)",
      "Bash(seite hooks:*)",
      "Bash(seite collection list)",
      "Glob",
      "Grep",
      "WebSearch",
      "mcp__seite"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "enabledMcpjsonServers": [
    "seite"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v seite >/dev/null 2>&1 && seite check --hook claude || true",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v seite >/dev/null 2>&1 && seite check --hook claude --post-edit || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

