{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write(content/**)",
      "Write(templates/**)",
      "Write(static/**)",
      "Edit(content/**)",
      "Edit(templates/**)",
      "Bash(seite build:*)",
      "Bash(seite build)",
      "Bash(seite new:*)",
      "Bash(seite serve:*)",
      "Bash(seite theme:*)",
      "Glob",
      "Grep",
      "WebSearch",
      "mcp__seite",
      "Edit(static/**)",
      "Edit(seite.toml)",
      "Bash(seite check:*)",
      "Bash(seite check)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "enabledMcpjsonServers": [
    "seite"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "seite check --hook claude",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
